# Copy to .env in the repo root (gitignored). `just` loads .env automatically.
#
# Env-mode bootstrap: same shape as prod (K8s Secret keys → iron-proxy env).
# No OP_SERVICE_ACCOUNT_TOKEN or OP_VAULT.

# --- Required for just bootstrap-secrets / just up ---

# Slack app (create at api.slack.com/apps). For smoke-only without Slack,
# dummy values are fine; Slackbot still starts but cannot post to Slack.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me

# Shared secret: Slackbot → Centaur API. Generate once:
#   openssl rand -hex 32
SLACKBOT_API_KEY=replace-me

# Codex default harness (just smoke uses this).
OPENAI_API_KEY=sk-replace-me

# --- Optional ---

# Claude Code / pi-mono harnesses
# ANTHROPIC_API_KEY=sk-ant-replace-me

# Git clone/push in sandboxes (needed for Launchpad PR work later)
# GITHUB_TOKEN=ghp_replace-me

# Admin API key (optional; auto-generated infra keys work for smoke)
# LOCAL_DEV_API_KEY=aiv2_replace-me
